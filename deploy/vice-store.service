# VICE STORE: systemd unit. Install as /etc/systemd/system/vice-store.service.
# Runs /srv/vice-store on 127.0.0.1:5300 with the server's Node (/usr/bin/node), as the vicestore user.
# Secrets: /etc/vice-store/env (root:vicestore, 640; KEY=value lines, no inline comments).
[Unit]
Description=VICE STORE (Next.js)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=vicestore
Group=vicestore
WorkingDirectory=/srv/vice-store
EnvironmentFile=/etc/vice-store/env
Environment=NODE_ENV=production
ExecStart=/usr/bin/node node_modules/next/dist/bin/next start -H 127.0.0.1 -p 5300
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=strict
ProtectHome=true
ReadWritePaths=/srv/vice-store/.next
ProtectKernelTunables=true
ProtectControlGroups=true
RestrictSUIDSGID=true

[Install]
WantedBy=multi-user.target
