# VICE STORE: Nginx site (HTTPS). Replace DOMAIN, install as /etc/nginx/sites-available/DOMAIN.
# Needs the Let's Encrypt certificate first (deploy/README.md, step 7). Self-contained: no shared
# includes, unique zone names, so it cannot clash with other sites on the server.
# Canonical host: https://DOMAIN (www and HTTP redirect to it). App: 127.0.0.1:5300.

upstream vice_store {
    server 127.0.0.1:5300;
    keepalive 16;
}

server {
    listen 80;
    server_name DOMAIN www.DOMAIN;

    location ^~ /.well-known/acme-challenge/ { root /var/www/letsencrypt; }
    location / { return 301 https://DOMAIN$request_uri; }
}

server {
    listen 443 ssl http2;
    server_name www.DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;

    return 301 https://DOMAIN$request_uri;
}

server {
    listen 443 ssl http2;
    server_name DOMAIN;

    ssl_certificate     /etc/letsencrypt/live/DOMAIN/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/DOMAIN/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    ssl_session_cache shared:vice_store_ssl:10m;
    ssl_session_timeout 1d;

    add_header Strict-Transport-Security "max-age=31536000" always;
    server_tokens off;

    # Payment screenshots (the app allows up to 5 MB).
    client_max_body_size 8m;

    access_log /var/log/nginx/vice-store.access.log;
    error_log  /var/log/nginx/vice-store.error.log;

    location /_next/static/ {
        proxy_pass http://vice_store;
        proxy_set_header Host $host;
        add_header Cache-Control "public, max-age=31536000, immutable";
        add_header Strict-Transport-Security "max-age=31536000" always;
    }

    location / {
        proxy_pass http://vice_store;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        # Overwrite, never append: the app trusts the first X-Forwarded-For entry (TRUST_PROXY=1).
        proxy_set_header X-Forwarded-For $remote_addr;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_set_header X-Forwarded-Proto $scheme;
        proxy_set_header X-Forwarded-Host $host;
        proxy_set_header Connection "";
        proxy_read_timeout 60s;
    }
}
