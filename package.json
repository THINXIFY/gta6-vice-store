{
  "name": "vice-storefront",
  "version": "0.1.0",
  "private": true,
  "engines": {
    "node": ">=20.9"
  },
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "next typegen && tsc --noEmit",
    "test:e2e": "node scripts/e2e.mjs",
    "check": "npm run typecheck && npm run lint && npm run build",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node scripts/db-migrate.mjs",
    "test:db": "node scripts/test-db.mjs",
    "test:email": "node --disable-warning=MODULE_TYPELESS_PACKAGE_JSON scripts/test-email.mjs",
    "db:backup": "node scripts/db-backup.mjs",
    "new-client": "node scripts/new-client.mjs",
    "brand:assets": "node scripts/brand-assets.mjs",
    "media:package": "node scripts/media-package.mjs"
  },
  "dependencies": {
    "@electric-sql/pglite": "0.5.15",
    "drizzle-orm": "0.45.4",
    "gsap": "3.15.1",
    "lenis": "1.3.27",
    "lucide-react": "1.77.0",
    "next": "16.4.6",
    "postgres": "3.4.9",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@playwright/test": "1.65.1",
    "@tailwindcss/postcss": "4.3.5",
    "@types/node": "24.19.2",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.4.6",
    "tailwindcss": "4.3.5",
    "typescript": "6.0.3"
  }
}
