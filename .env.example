# Public site URL (used for metadata)
# Canonical origin, e.g. https://www.example-store.com (no trailing slash). Drives canonical URLs,
# Open Graph, sitemap, structured data and email links. Use a domain without Rockstar/Take-Two marks.
NEXT_PUBLIC_SITE_URL=
# Search indexing is on by default (pages indexable, robots.txt open, sitemap filled).
# Set to "false" only for a staging or private copy.
NEXT_PUBLIC_INDEXABLE=
# Real checkout and crypto payments (build time). "true" only once Admin → Launch checklist passes;
# empty = non-transactional preview (buy buttons disabled, no orders).
NEXT_PUBLIC_CHECKOUT_ENABLED=
# Show draft FAQ answers (tagged "Draft") for review. Local only.
NEXT_PUBLIC_CONTENT_PREVIEW=
# PostgreSQL connection (production). Unset = embedded PGlite at PGLITE_DIR for local dev/tests.
DATABASE_URL=
PGLITE_DIR=
# Salt for hashing client IPs in audit logs. Set a long random value in production.
IP_HASH_SALT=
# Trust X-Forwarded-For for client IPs (only behind a proxy that sets it). 1 = trust.
TRUST_PROXY=
# 32-byte base64 key encrypting fulfillment codes/links (required with DATABASE_URL). Generate:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
FULFILLMENT_KEY=
# First admin, created only when no admin exists (min 12-char password). Remove after first sign-in.
ADMIN_BOOTSTRAP_EMAIL=
ADMIN_BOOTSTRAP_PASSWORD=
# Admin two-factor: 1 = every admin must use an authenticator app (recommended in production).
#   Lost authenticator: an owner resets it in Settings, or run scripts/admin-reset-2fa.mjs <email>.
ADMIN_REQUIRE_2FA=
# Days payment screenshots are kept before owners can delete them (closed orders only; 7-3650, default 90).
SCREENSHOT_RETENTION_DAYS=
# Exchange rates for quotes: live (default; CoinGecko, Coinbase fallback) or fixed (tests/offline, preview only).
RATES_MODE=

# ── Transactional email (GTA-09D) ────────────────────────────────────────────
# test (default): nothing reaches customers. With SMTP + EMAIL_TEST_RECIPIENT every email is
# redirected there and marked as a test; without them emails are only logged as skipped.
# live: real recipients, and only while live checkout is open. off: log only.
EMAIL_MODE=test
# The From ADDRESS (must belong to the SMTP domain). The display name, reply-to and admin alert
# recipients can be changed in Admin → Emails, which takes precedence over the values here.
EMAIL_FROM="VICE <orders@example.com>"
EMAIL_REPLY_TO=
EMAIL_TEST_RECIPIENT=
# Admin alerts for new payment submissions (comma-separated). Empty = all active owners.
ADMIN_NOTIFY_EMAIL=
# SMTP submission. SMTP_SECURITY: starttls (587, default) | tls (465) | none (localhost only).
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURITY=starttls
SMTP_USER=
SMTP_PASS=

# ── Search engines (GTA-11B) ─────────────────────────────────────────────────
# Ownership verification tokens (HTML meta tag method). Leave empty until the domain is final.
GOOGLE_SITE_VERIFICATION=
BING_SITE_VERIFICATION=
